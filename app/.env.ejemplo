# Copia este archivo como app/.env y completa los valores. Nunca publiques app/.env.

# Groq (modelo generativo del agente)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Supabase: URL del proyecto y clave publicable (nunca una clave administrativa).
# Cada persona inicia sesión en la aplicación con su propia cuenta de Supabase Auth.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Cuenta dueña del corpus (Supabase Auth). Al arrancar, corpus.py compara los
# textos del corpus con Supabase: si cambiaron, genera una versión nueva.
# La cuenta debe estar en administradores_corpus (migración 003).
# Si se dejan vacías, la app usa CORPUS_ID sin sincronizar.
CORPUS_EMAIL=
CORPUS_PASSWORD=

# Corpus y embeddings. CORPUS_ID y EMBEDDINGS_REVISION se escriben solos cuando
# corpus.py genera una versión nueva; en una instalación nueva pueden quedar
# vacíos. Los valores actuales también están en evidencias/Clase_08_Evidencia_RAG.json
CORPUS_ID=
EMBEDDINGS_MODELO=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_REVISION=

# Servidor de Gradio (ejecución local)
GRADIO_SERVER_NAME=127.0.0.1
PORT=7860

# Solo para las pruebas de app/pruebas (dos cuentas distintas de Supabase Auth)
PRUEBA_USUARIO_A_EMAIL=
PRUEBA_USUARIO_A_PASSWORD=
PRUEBA_USUARIO_B_EMAIL=
PRUEBA_USUARIO_B_PASSWORD=
